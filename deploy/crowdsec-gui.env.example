# Shared secret between UI and helper.
# MUST be identical on both sides. Generate with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
HELPER_SECRET=replace_with_a_random_secret

# Flask session signing key for the UI.
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET=replace_with_a_random_secret

# Helper bind settings (host helper service)
HELPER_HOST=127.0.0.1
HELPER_PORT=9099

# UI helper URL (used by the UI container to reach the helper)
HELPER_URL=http://host-gateway:9099

# The UI is served through HTTPS by NGINX Proxy Manager.
SESSION_COOKIE_SECURE=true

# Optional: audit log path
AUDIT_LOG=/opt/crowdsec-gui/helper/crowdsec-audit.log
